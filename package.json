{
  "name": "cutline",
  "productName": "Cutline",
  "version": "0.28.0",
  "private": true,
  "description": "A local video editor with editable motion, built-in Claude and Codex assistance",
  "author": "Neil Busque",
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "qa": "node scripts/qa-reel.mjs",
    "setup:vendor": "node scripts/setup-vendor.mjs",
    "qa:integrations": "node scripts/qa-integrations.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "qa:creative": "node scripts/qa-creative.mjs",
    "qa:layers": "node scripts/qa-layers.mjs",
    "qa:transitions": "node scripts/qa-transitions.mjs",
    "qa:reel": "node scripts/qa-reel.mjs",
    "setup:speech": "node scripts/setup-speech.mjs",
    "qa:audio": "node scripts/qa-audio.mjs",
    "qa:auto": "node scripts/qa-auto.mjs",
    "qa:captions": "node scripts/qa-caption-studio.mjs",
    "qa:motion": "node scripts/qa-motion.mjs",
    "qa:agents": "node scripts/qa-agent-control.mjs",
    "qa:music": "node scripts/qa-music-sync.mjs",
    "qa:studio": "node scripts/qa-studio.mjs",
    "qa:professional": "node scripts/qa-professional.mjs",
    "qa:vector": "node scripts/qa-vector.mjs",
    "qa:screens": "node scripts/qa-screens.mjs",
    "qa:claude": "node scripts/qa-claude.mjs",
    "qa:claude-code": "node scripts/qa-claude-code.mjs",
    "qa:heavy": "node scripts/qa-heavy-footage.mjs",
    "qa:generation": "node scripts/qa-generation.mjs",
    "qa:story": "node scripts/qa-story.mjs",
    "qa:references": "node scripts/qa-references.mjs",
    "qa:product": "node scripts/qa-product-film.mjs",
    "qa:promo": "node scripts/qa-promo-alpha.mjs && node scripts/qa-promo.mjs",
    "qa:sessions": "node scripts/qa-sessions.mjs",
    "qa:reel-formats": "node scripts/qa-reel-formats.mjs",
    "qa:creator-shorts": "node scripts/qa-creator-shorts.mjs",
    "setup:runtime": "node scripts/setup-runtime.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/darwin-arm64": "4.1.5",
    "@ffprobe-installer/darwin-arm64": "5.0.1",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@remotion/bundler": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "kokoro-js": "1.2.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.538",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "ip-address": "10.7.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
